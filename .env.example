# Copy this file to .env and fill in real values.
# Never commit .env — constitution Principle VIII / FR-022.

DISCORD_BOT_TOKEN=
TRELLO_API_KEY=
TRELLO_TOKEN=
GEMINI_API_KEY=

# Otter AI now authenticates via OAuth through its MCP Server, not a static
# API key (research.md R11/R12). The MCP SDK performs dynamic OAuth client
# registration against the server automatically — no static client ID/secret
# needed here. The resulting access/refresh tokens (and the dynamically
# issued client registration) are stored in SQLite (OtterCredentials table),
# never in this file.
OTTER_MCP_SERVER_URL=

# Optional: override the default SQLite database path (defaults to ./data/app.db)
DATABASE_PATH=

# Web API layer (feature 002-web-frontend)
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts every per-user integration secret at rest (research.md R3). Required — the API
# will not start without it.
APP_ENCRYPTION_KEY=

# Set to true in production (HTTPS) so the session cookie is only sent over TLS.
APP_SESSION_COOKIE_SECURE=false

# The app's public-facing origin (the Next.js dev proxy in dev, or your production
# reverse-proxy domain) — used to build OAuth redirect URLs that must stay on the same
# origin as the session cookie (research.md R4). Defaults to the Next.js dev server.
APP_PUBLIC_URL=http://localhost:3000
