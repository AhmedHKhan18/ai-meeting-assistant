# Copy this file to .env and fill in real values.
# Never commit .env — constitution Principle VIII / FR-022.

DISCORD_BOT_TOKEN=
TRELLO_API_KEY=
TRELLO_TOKEN=
GEMINI_API_KEY=

# Otter AI now authenticates via OAuth through its MCP Server, not a static
# API key (research.md R11/R12). The MCP SDK performs dynamic OAuth client
# registration against the server automatically — no static client ID/secret
# needed here. The resulting access/refresh tokens (and the dynamically
# issued client registration) are stored in SQLite (OtterCredentials table),
# never in this file.
OTTER_MCP_SERVER_URL=

# Optional: override the default SQLite database path (defaults to ./data/app.db)
DATABASE_PATH=
